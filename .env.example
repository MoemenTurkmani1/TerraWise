# NASA POWER and local demo mode do not require API keys.
# To enable account mode, copy this file to .env.local and set the public values:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# A legacy public anon JWT can also be used as VITE_SUPABASE_ANON_KEY.
# Never put a Supabase service-role or secret key in a VITE_ variable.
