# Server only. Never paste real keys into source code, chat or VITE_ variables.
AGRONOMIST_AI_PROVIDER=gemini
AGRONOMIST_AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AGRONOMIST_COST_MODE=free-only
# Leave false until all services are confirmed Free with no payment method/billing.
# This is an operator attestation; the code cannot remotely verify billing status.
AGRONOMIST_FREE_TIER_CONFIRMED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AGRONOMIST_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional stricter limits (only reductions allowed):
AGRONOMIST_GLOBAL_RPM=2
AGRONOMIST_GLOBAL_RPD=20
# Supabase supplies SUPABASE_URL and public keys on hosted functions.
# SUPABASE_PUBLISHABLE_KEYS default entry or legacy SUPABASE_ANON_KEY.
# No service-role key. Old OPENAI_* settings are not read.
